rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAllowedEditor() {
      return request.auth != null
        && request.auth.token.email == 'psychiatristlee@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && (request.auth.token.admin == true || request.auth.token.editor == true);
    }

    // 블로그 이미지는 누구나 읽기 가능
    match /blog-images/{allPaths=**} {
      allow read: if true;
      allow write: if isAllowedEditor();
    }
    // 성격 검사 캐릭터 이미지는 누구나 읽기 가능
    match /personality/{allPaths=**} {
      allow read: if true;
      allow write: if false; // 관리자 스크립트로만 업로드
    }
    // 임시 이미지 (미리보기용) - 인증된 editor/admin만 읽기 가능
    match /temp/{allPaths=**} {
      allow read: if isAllowedEditor();
      allow write: if false; // Cloud Functions에서만 쓰기
    }
    // 나머지는 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
